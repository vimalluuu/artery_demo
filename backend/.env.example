PROJECT_NAME="VascuAI - Artery Segmentation & Stenosis Detection API"
API_V1_STR="/api/v1"
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER="vascuai"
JWT_AUDIENCE="vascuai-api"
DATABASE_URL="postgresql+psycopg://vascuai:replace-with-local-password@localhost:5432/vascuai"
TESTING=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://localhost:8123","http://127.0.0.1:8123","http://127.0.0.1:8000","http://127.0.0.1:5500"]
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"

# Optional experimental CT segmentation. Absolute artifact path, outside Git.
VASCULAI_MODEL_CHECKPOINT=""
VASCULAI_MODEL_THRESHOLD=0.70
VASCULAI_MODEL_DEVICE=cpu
VASCULAI_MODEL_BATCH_SIZE=1
VASCULAI_MODEL_THREADS=4
VASCULAI_MODEL_MAX_VOXELS=67108864
