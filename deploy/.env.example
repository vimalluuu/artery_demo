# Copy to deploy/.env and fill values. No secrets belong in VITE_* variables.
POSTGRES_USER=vascuai
POSTGRES_DB=vascuai
POSTGRES_PASSWORD=
SECRET_KEY=
# Use URL-encoded database credentials. A generated hex password needs no escaping.
DATABASE_URL=postgresql+psycopg://vascuai:REPLACE_WITH_DATABASE_PASSWORD@db:5432/vascuai
# Same-origin deployment needs no CORS allowlist. Set actual origins for split hosting.
CORS_ORIGINS=[]
WEB_PORT=8080
# Optional compose.model.yaml overlay: host directory containing the checkpoint.
MODEL_ARTIFACT_DIR=
VASCULAI_MODEL_THRESHOLD=0.70
VASCULAI_MODEL_BATCH_SIZE=1
VASCULAI_MODEL_THREADS=4
VASCULAI_MODEL_MAX_VOXELS=67108864
